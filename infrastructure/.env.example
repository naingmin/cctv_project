# Copy this file to .env and replace every blank secret before starting the full
# stack. This file is a template; infrastructure/.env is ignored by Git.
ENVIRONMENT=development
DEBUG=false

# --- MongoDB ---
# Use a unique username/password. Compose initializes the local MongoDB root
# account from these values; changing them does not update an existing volume.
# Generate a Compose-safe password with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
MONGODB_URI=
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_AUTH_SOURCE=admin
MONGODB_DATABASE=cctv_manager

# --- JWT ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

# --- Default admin seed ---
# Generate a unique password with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=

# --- CCTV credential encryption ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Keep this key stable and secret; losing it makes stored CCTV credentials unreadable.
CCTV_CREDENTIALS_ENCRYPTION_KEY=

# --- Object storage (MinIO / S3-compatible) ---
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=cctv-media
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
CORS_ORIGINS=["http://localhost:3000"]

# --- MediaMTX playback URLs (must be reachable from Flutter clients) ---
# Internal control API; loopback-only on the host for native backend runs.
MEDIAMTX_API_URL=http://localhost:9997
# Set these to the public hostname / reverse-proxy paths outside local dev.
MEDIAMTX_WHEP_BASE_URL=http://localhost:8889
MEDIAMTX_HLS_BASE_URL=http://localhost:8888
# Public IP/DNS name advertised in WebRTC ICE candidates.
MEDIAMTX_WEBRTC_ADDITIONAL_HOSTS=localhost

# ---- App ----
APP_NAME=CCTV Data Collection & Management System
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# ---- MongoDB ----
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=cctv_manager

# ---- JWT ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- CCTV credentials encryption ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Keep this key stable and secret; losing it makes stored CCTV credentials unreadable.
CCTV_CREDENTIALS_ENCRYPTION_KEY=

# ---- Object storage (MinIO / S3-compatible) ----
# Endpoint this process uses for S3 calls.
MINIO_ENDPOINT=http://localhost:9000
# Endpoint embedded in presigned URLs. Must be reachable by the *client*,
# since the client is what PUTs and GETs. Defaults to MINIO_ENDPOINT if unset.
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=cctv-media
MINIO_REGION=us-east-1
MINIO_USE_SSL=false
PRESIGN_EXPIRE_SECONDS=300
MAX_IMAGE_SIZE_MB=10

# ---- CORS (JSON array; never "*" in production) ----
# Must be a JSON array, not a comma-separated list: pydantic-settings
# JSON-decodes fields typed as List[str] before the _split_origins validator in
# config.py runs, so a plain comma-separated value raises SettingsError.
# `_split_origins` still handles the comma form for real OS env vars.
CORS_ORIGINS=["http://localhost:3000"]
# Regex alternative for dev servers on random ports, e.g. `flutter run -d chrome`
# binds a new one each run. Ignored when ENVIRONMENT is production.
# CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$

# ---- Map ----
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=© OpenStreetMap contributors

# ---- Default admin (seed only; change password after first login) ----
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=Admin@12345
DEFAULT_ADMIN_FULL_NAME=System Administrator
